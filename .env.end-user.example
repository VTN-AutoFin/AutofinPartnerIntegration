# =============================================================
# EXAMPLE 2 — END-USER account mode (MỘT tài khoản user đối tác)
# =============================================================
# Dùng khi site đối tác muốn gọi API finserver bằng CHÍNH tài khoản user
# đã đăng nhập (auto-login bởi proxy), KHÔNG tách danh tính từng khách.
#
# KHÁC BIỆT với org mode (xem .env.example):
#   org mode   : ORG_*  → token PER-VISITOR → mỗi khách 1 lịch sử chat ✅
#   end-user   : PARTNER_* → MỘT user token chung → MỌI khách chia sẻ
#                CHUNG lịch sử chat ❌ (route chat LUÔN ưu tiên ORG_* nếu có)
#
# Copy file này → .env khi muốn thử chế độ single-user.

# ---- Proxy server ----
PORT=5501

# ---- Nguồn API (local) ----
WEBAPP_UPSTREAM=localhost:4200
FIN_UPSTREAM=http://localhost:3000/api
FAC_WEB_UPSTREAM=http://localhost:5173
FAC_API_UPSTREAM=http://localhost:8002

# ---- End-user account (auto-login bởi proxy) ----
# = MỘT tài khoản user thật của đối tác (đăng nhập bằng email/username +
# password như app). Proxy login GIÙM và gắn Bearer server-side; browser
# không bao giờ thấy password/token.
#
# Account ENTERPRISE (thuộc partner org) — xem user trong WebApp Tổ chức:
PARTNER_CODE=DEMO
PARTNER_CLIENT_ID=demo              # username
PARTNER_CLIENT_SECRET=demo123456    # password
#
# Account INDIVIDUAL (cá nhân) — vd dev account:
# PARTNER_CLIENT_ID=agent-dev@autofin.vn
# PARTNER_CLIENT_SECRET=12345678

# Dịch vụ auth — trống = dùng FIN_UPSTREAM
AUTH_API_BASE=

# KHÔNG đặt ORG_* trong chế độ này: route chat ưu tiên ORG_* — để trống để
# chắc chắn thấy hành vi single-user (mọi khách chung 1 lịch sử).
# ORG_CLIENT_ID=
# ORG_CLIENT_SECRET=

# ---- Khách demo (vẫn dùng để chạy example app, nhưng KHÔNG tác dụng
#      tách danh tính chat trong chế độ end-user) ----
DEMO_VISITOR_ID=kh-001

# ---- Example app (build time) ----
VITE_PARTNER_CODE=DEMO
VITE_DEMO_VISITOR_ID=kh-001
VITE_API_BASE=
