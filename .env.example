# ---- Proxy server (server/server.mjs) ----

# Cổng proxy công khai — đây là domain duy nhất browser thấy
PORT=5501

# Nguồn API thật (CHỈ server proxy biết)
FIN_UPSTREAM=http://localhost:3000
WEBAPP_UPSTREAM=http://localhost:4200

# FAC ChatPanel (chat widget) — bundle fac-chat.js + FAC backend
FAC_WEB_UPSTREAM=http://localhost:5173
FAC_API_UPSTREAM=http://localhost:8002

# Credential máy chủ của tổ chức — cấp trong console đối tác (tab "Kết nối hệ thống")
# hoặc do AUTOFIN cấp trực tiếp. KHÔNG BAO GIỜ đưa 2 giá trị này xuống browser.
ORG_CLIENT_ID=DEMO_svc
ORG_CLIENT_SECRET=change-me

# ---- Example app (build time, tùy chọn) ----
# Để trống = dùng cùng origin (khuyến nghị: không CORS, không lộ domain nguồn).
# Chỉ đặt khi widget chạy trên site đối tác và gọi qua domain proxy công khai,
# ví dụ VITE_API_BASE=https://api.tenmien-doitac.vn
VITE_API_BASE=
