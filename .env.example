# ---- Proxy server (server/server.mjs) ----

# Cổng proxy công khai — đây là domain duy nhất browser thấy
PORT=5501

# ---- Nguồn API thật (CHỈ server proxy biết) ----

# WebApp — nguồn SDK widget (GET /embed/autofin-embed.js)
WEBAPP_UPSTREAM=https://sit.autofin.vn:4443

# FAC frontend — GET /remote/fac-chat.js → 200 đã verify
FAC_WEB_UPSTREAM=https://api-sit.autofin.vn:4443/financial-agent

# FAC backend — /api/v1/* (401 JSON đã verify — tồn tại, cần login)
# proxy nối thẳng originalUrl /api/v1/... vào base này (KHÔNG thêm /api)
FAC_API_UPSTREAM=https://api-sit.autofin.vn:4443/financial-agent

# finserver SIT — base ĐÃ KÈM prefix (proxy tự bỏ /api khỏi path browser).
# SIT: finserver nằm sau nginx /gateway/api trên api-sit:4443.
FIN_UPSTREAM=https://api-sit.autofin.vn:4443/gateway/api

# Dịch vụ auth (partner auto-login) — trống = dùng FIN_UPSTREAM
AUTH_API_BASE=https://api-sit.autofin.vn:4443/gateway/api


# Partner auto-login — proxy login GIÚM lấy user token, gắn Bearer server-side.
# Frontend KHÔNG bao giờ thấy token. Điền credential partner của SIT ở đây.
PARTNER_CODE=DEMO
PARTNER_CLIENT_ID=demo
PARTNER_CLIENT_SECRET=change-me

# ---- Example app (build time) ----
VITE_API_BASE=
