# =============================================================
# EXAMPLE 1 — ORG mode (ĐÚNG CÁCH cho widget chat: danh tính TỪNG khách)
# =============================================================
# Org machine token (cặp khóa máy cấp ở console AUTOFIN, tab "Kết nối hệ
# thống") → proxy mint token end-user PER-VISITOR → mỗi khách có lịch sử chat
# + workspace riêng trong org đối tác.
#
# Chuỗi 3 bước proxy tự làm (không cần env nào thêm):
#   1. POST /api/org/token {externalUserId} (Basic ORG_CLIENT_ID:SECRET)
#      → token end-user cho khách. Cookie phiên khách do PROXY đặt.
#   2. Chat finserver (/api/gw/v1/chat/*): Bearer token end-user đó.
#   3. FAC (/api/v1/*, /financial-agent/api/*): proxy đổi token end-user lấy
#      JWT FAC ở POST {FAC_API_UPSTREAM}/api/v1/auth/central/exchange, cache
#      25' — FAC tự tạo user khách trong org đối tác (email
#      {ext}@end-user.p{partner_id}.fac.autofin, role member).
#
# ⚠️ finserver PHẢI set env END_USER_IDENTITY_SECRET (HMAC data key dùng để
# hash danh tính khách — Admin repo, apps/finserver). Thiếu → org/token trả
# 400 END_USER_IDENTITY_MISCONFIGURED. Đổi secret = ĐỔI TÊN mọi khách đã có
# và mất lịch sử chat của họ — chọn 1 lần rồi giữ nguyên.

# Cổng proxy công khai — domain duy nhất browser thấy
PORT=5501

# ---- Nguồn API thật (CHỈ server proxy biết) ----

# WebApp — nguồn SDK widget (GET /embed/autofin-embed.js)
# SIT không có WebApp công khai → dùng bundle PROD.
WEBAPP_UPSTREAM=https://www.autofin.vn

# finserver — base ĐÃ KÈM prefix /api (proxy tự bỏ /api khỏi path browser).
# PROD: https://api.autofin.vn/gateway/api
# SIT:  https://api-sit.autofin.vn:4443/gateway/api
FIN_UPSTREAM=https://api-sit.autofin.vn:4443/gateway/api

# FAC có HAI nguồn (đều bắt buộc), PROD/SIT web+API cùng base sau nginx:
#   PROD: https://www.autofin.vn/financial-agent
#   SIT:  https://api-sit.autofin.vn:4443/financial-agent
FAC_WEB_UPSTREAM=https://api-sit.autofin.vn:4443/financial-agent
FAC_API_UPSTREAM=https://api-sit.autofin.vn:4443/financial-agent

# ---- Org machine token (BẮT BUỘC ở chế độ này) ----
# Lấy từ console AUTOFIN tab "Kết nối hệ thống". KHÔNG phải user/password.
ORG_CLIENT_ID=TENPARTNER_svc
ORG_CLIENT_SECRET=change-me

# ---- Khách demo (CHỈ demo — project ví dụ) ----
# id khách mặc định khi /demo/login không nhận visitorId. TÍCH HỢP THẬT: BỎ
# biến này — id khách do backend đối tác quyết định TRONG CODE (từ phiên đăng
# nhập thật của hệ họ), không bao giờ từ env hay từ browser.
ORG_END_USER_ID=kh-001

# ---- Dịch vụ auth — KHÔNG dùng (partner user login đã bỏ khỏi proxy) ----
AUTH_API_BASE=

# ---- Example app (build time) ----
VITE_PARTNER_CODE=
VITE_ORG_END_USER_ID=kh-001
# Trống = bundle đi cùng origin qua proxy (browser không thấy API nguồn).
VITE_API_BASE=
