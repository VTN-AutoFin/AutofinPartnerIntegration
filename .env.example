# ---- Proxy server (server/server.mjs) ----

# Cổng proxy công khai — đây là domain duy nhất browser thấy
PORT=5501

# ---- Nguồn API thật (CHỈ server proxy biết) ----

# WebApp — nguồn SDK widget (GET /embed/autofin-embed.js)
WEBAPP_UPSTREAM=https://www.autofin.vn

# finserver — base ĐÃ KÈM prefix (proxy tự bỏ /api khỏi path browser).
# PROD: finserver nằm sau nginx /gateway/api trên api.autofin.vn.
# LOCAL: http://localhost:3000/api
FIN_UPSTREAM=https://api.autofin.vn/gateway/api

# FAC có HAI nguồn (đều bắt buộc):
#
# 1. FAC_WEB_UPSTREAM — bundle chatpanel (GET /remote/fac-chat.js do FRONTEND
#    FAC phục vụ). Proxy cache 5'.
# 2. FAC_API_UPSTREAM — FAC backend cho MỌI API /api/v1/* và
#    /financial-agent/api/* (gồm cả endpoint /auth/central/exchange mà proxy
#    gọi server-side để đổi token khách lấy JWT FAC — T5 partner visitor).
#    Ghép thẳng originalUrl vào base, KHÔNG thêm gì.
#
# PROD / SIT (web + API cùng base sau nginx):
#   FAC_WEB_UPSTREAM=https://www.autofin.vn/financial-agent
#   FAC_API_UPSTREAM=https://www.autofin.vn/financial-agent
# LOCAL DEV (frontend FAC vite :5173, backend FAC :8002 không có prefix):
FAC_WEB_UPSTREAM=http://localhost:5173
FAC_API_UPSTREAM=http://localhost:8002

# Dịch vụ auth (partner auto-login) — trống = dùng FIN_UPSTREAM
AUTH_API_BASE=https://api.autofin.vn/gateway/api

# ---- Auth: ĐÚNG CÁCH cho widget chat (danh tính từng khách) ----
#
# Org machine token — cặp khóa cấp ở console AUTOFIN, tab "Kết nối hệ thống"
# (Bước 1 của hướng dẫn tích hợp). Proxy dùng nó theo 3 bước:
#   1. POST /api/org/token {externalUserId} (Basic auth) → token end-user
#      PER-VISITOR. Cookie phiên khách (demo_visitor) do PROXY đặt — browser
#      không bao giờ tự chọn danh tính.
#   2. Chat finserver (/api/gw/v1/chat/*): Bearer token end-user đó.
#   3. FAC (/api/v1/*, /financial-agent/api/*): proxy đổi token end-user lấy
#      JWT FAC tại POST {FAC_API_UPSTREAM}/api/v1/auth/central/exchange rồi
#      cache 25' (JWT FAC không có exp; phiên bên trong TTL 30'). FAC tự tạo/
#      tra cứu user khách trong org đối tác (T5 partner visitor) — phía widget
#      KHÔNG cần thêm env nào.
# Chỉ tồn tại server-side. Đây là đường DUY NHẤT dùng được cho widget Chat AI:
# token cấp theo từng khách nên mỗi khách có lịch sử chat + workspace riêng.
ORG_CLIENT_ID=DEMO_svc
ORG_CLIENT_SECRET=change-me

# ---- Auth: partner auto-login (KHÔNG dùng cho chat của khách) ----
#
# Proxy login GIÚM lấy user token, gắn Bearer server-side cho các route
# finserver THƯỜNG (không phải chat). LƯU Ý: đây là MỘT tài khoản user, không
# phải cặp khóa máy chủ ORG_* ở trên. Khi cả hai đều có, proxy ưu tiên partner
# token cho các route thường; route chat LUÔN dùng ORG_*.
#
# KHÔNG dùng được cho Chat AI: mọi khách sẽ chia sẻ CHUNG một lịch sử chat vì
# tất cả mang danh tính của đúng tài khoản này.
# PARTNER_CODE=DEMO
# PARTNER_CLIENT_ID=demo            # username đăng nhập
# PARTNER_CLIENT_SECRET=change-me   # mật khẩu

# ---- Example app (build time) ----

# Mã tổ chức AUTOFIN cấp — widget dùng để nhận diện đối tác.
VITE_PARTNER_CODE=
# Base API nhúng vào bundle lúc build — để trống để đi cùng origin qua proxy
# (browser chỉ thấy proxy, không thấy API nguồn).
VITE_API_BASE=
